@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/SuperaDataTargets.cmake")
set(Supera_data_FOUND TRUE)
foreach(component IN LISTS Supera_FIND_COMPONENTS)
  if(component STREQUAL "larcv2" AND @SUPERA_BUILD_LARCV2@)
    include("${CMAKE_CURRENT_LIST_DIR}/SuperaLArCV2Targets.cmake")
    set(Supera_larcv2_FOUND TRUE)
  elseif(component STREQUAL "labeling" AND @SUPERA_BUILD_LABELING@)
    find_dependency(yaml-cpp)
    include("${CMAKE_CURRENT_LIST_DIR}/SuperaLabelingTargets.cmake")
    set(Supera_labeling_FOUND TRUE)
  endif()
endforeach()
check_required_components(Supera)
